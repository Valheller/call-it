      "borderless": false,
      "maximize": false,
      "hidden": false,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "Call-it",
    "resourcesPath": "/resources/",
    "binaryVersion": "6.5.0"
  },
  "port": 47823
}